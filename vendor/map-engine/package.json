{
  "name": "@travisduffy/map-engine",
  "version": "0.0.7",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travisduffy/map-engine.git"
  },
  "homepage": "https://github.com/travisduffy/map-engine#readme",
  "bugs": {
    "url": "https://github.com/travisduffy/map-engine/issues"
  },
  "description": "Render an interactive map from a PNG bitmap and a JSON file with Three.js: color-coded sectors, picking, recoloring, and worker-side pathfinding.",
  "keywords": [
    "map",
    "three",
    "threejs",
    "webgl",
    "webgl2",
    "bitmap",
    "grand-strategy",
    "worker",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/REFERENCE.md",
    "docs/example.png",
    "example/public/map.png",
    "example/public/sectors.json"
  ],
  "peerDependencies": {
    "three": "^0.160.0",
    "@types/three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  }
}
